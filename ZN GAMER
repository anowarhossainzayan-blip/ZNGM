            border-left: 5px solid #ff4a5a;
            padding: 12px;
            margin: 20px 0;
            border-radius: 4px;
            text-align: left;
            color: #ff8893;
        }

        /* অ্যাকশন বাটন */
        .btn {
            display: inline-block;
            background: linear-gradient(90deg, #ff4a5a, #b32535);
            color: #fff;
            padding: 15px 40px;
            font-size: 1.2rem;
            font-weight: bold;
            text-decoration: none;
            border-radius: 50px;
            box-shadow: 0 0 15px rgba(255, 74, 90, 0.4);
            transition: 0.3s;
            margin-top: 10px;
            border: none;
            cursor: pointer;
        }

        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 25px rgba(255, 74, 90, 0.8);
        }

        .btn-youtube {
            background: #ff0000;
            box-shadow: 0 0 15px rgba(255, 0, 0, 0.4);
            margin-bottom: 20px;
        }

        .btn-youtube:hover {
            background: #cc0000;
            box-shadow: 0 0 25px rgba(255, 0, 0, 0.8);
        }

        /* ভিডিও গ্যালারি গ্রিড সেকশন */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 25px;
            margin-top: 20px;
        }

        .video-card {
            background-color: #1f2833;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            border: 1px solid #2c3540;
            transition: 0.3s;
        }

        .video-card:hover {
            transform: translateY(-5px);
            border-color: #45f3ff;
        }

        /* রেসপনসিভ ইউটিউব প্লেয়ার কন্টেইনার */
        .video-responsive {
            overflow: hidden;
            padding-bottom: 56.25%;
            position: relative;
            height: 0;
        }

        .video-responsive iframe {
            left: 0;
            top: 0;
            height: 100%;
            width: 100%;
            position: absolute;
            border: 0;
        }

        .video-info {
            padding: 15px;
            text-align: left;
        }

        .video-info h3 {
